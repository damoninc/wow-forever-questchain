<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <Frame name="ForeverQuestChainJournalTabTemplate" inherits="LargeSideTabButtonTemplate"
           virtual="true" enableMouse="true">
        <KeyValues>
            <KeyValue key="fillToInterior" value="true" type="boolean"/>
        </KeyValues>
    </Frame>
    <Frame name="ForeverQuestChainWindowTemplate" inherits="PortraitFrameTemplate"
           mixin="ForeverQuestChainWindowMixin" virtual="true"
           hidden="true" movable="true" resizable="true" clampedToScreen="true" enableMouse="true" frameStrata="DIALOG">
        <Size x="1000" y="622"/>
        <Anchors><Anchor point="CENTER"/></Anchors>
        <Frames>
            <Frame parentKey="questList" inherits="ForeverQuestChainQuestListTemplate">
                <Anchors><Anchor point="TOPLEFT" x="14" y="-56"/></Anchors>
            </Frame>
            <Frame parentKey="rewards" inherits="ForeverQuestChainRewardPageTemplate">
                <Anchors><Anchor point="TOPLEFT" x="14" y="-56"/></Anchors>
            </Frame>
            <Frame parentKey="questDetails" inherits="ForeverQuestChainQuestDetailsTemplate">
                <Anchors><Anchor point="TOPRIGHT" x="-14" y="-56"/></Anchors>
            </Frame>
            <Frame parentKey="timeline" inherits="ForeverQuestChainTimelinePageTemplate">
                <Anchors><Anchor point="TOPLEFT" x="14" y="-56"/></Anchors>
            </Frame>
            <Frame parentKey="locations" inherits="ForeverQuestChainLocationPageTemplate">
                <Anchors><Anchor point="TOPLEFT" x="14" y="-56"/></Anchors>
            </Frame>
            <Frame parentKey="activeChains" inherits="ForeverQuestChainActiveChainsPageTemplate">
                <Anchors><Anchor point="TOPLEFT" x="14" y="-56"/></Anchors>
            </Frame>
            <Frame parentKey="DragHeader" enableMouse="true">
                <Size y="21"/>
                <Anchors>
                    <Anchor point="TOPLEFT" x="60" y="-1"/>
                    <Anchor point="TOPRIGHT" x="-28" y="-1"/>
                </Anchors>
            </Frame>
            <Button parentKey="ResizeGrip">
                <Size x="20" y="20"/>
                <Anchors><Anchor point="BOTTOMRIGHT" x="-5" y="5"/></Anchors>
                <NormalTexture file="Interface\ChatFrame\UI-ChatIM-SizeGrabber-Up"/>
                <HighlightTexture file="Interface\ChatFrame\UI-ChatIM-SizeGrabber-Highlight"/>
                <PushedTexture file="Interface\ChatFrame\UI-ChatIM-SizeGrabber-Down"/>
            </Button>
            <Frame parentKey="JournalTabs">
                <Size x="1" y="1"/>
                <Anchors><Anchor point="TOPLEFT" relativePoint="TOPRIGHT" y="-56"/></Anchors>
                <Frames>
                    <Frame parentKey="Search" inherits="ForeverQuestChainJournalTabTemplate">
                        <Anchors><Anchor point="TOPLEFT"/></Anchors>
                        <KeyValues>
                            <KeyValue key="tooltipText" value="Search" type="string"/>
                            <KeyValue key="iconTexture" value="Interface\Icons\INV_Misc_Spyglass_03" type="string"/>
                        </KeyValues>
                    </Frame>
                    <Frame parentKey="Zones" inherits="ForeverQuestChainJournalTabTemplate">
                        <Anchors><Anchor point="TOPLEFT" relativeKey="$parent.Search" relativePoint="BOTTOMLEFT" y="-2"/></Anchors>
                        <KeyValues>
                            <KeyValue key="tooltipText" value="Zones" type="string"/>
                            <KeyValue key="iconTexture" value="Interface\Icons\INV_Misc_Map_01" type="string"/>
                        </KeyValues>
                    </Frame>
                    <Frame parentKey="Dungeons" inherits="ForeverQuestChainJournalTabTemplate">
                        <Anchors><Anchor point="TOPLEFT" relativeKey="$parent.Zones" relativePoint="BOTTOMLEFT" y="-2"/></Anchors>
                        <KeyValues>
                            <KeyValue key="tooltipText" value="Dungeons" type="string"/>
                            <KeyValue key="iconTexture" value="Interface\Icons\INV_Misc_Key_14" type="string"/>
                        </KeyValues>
                    </Frame>
                    <Frame parentKey="Classes" inherits="ForeverQuestChainJournalTabTemplate">
                        <Anchors><Anchor point="TOPLEFT" relativeKey="$parent.Dungeons" relativePoint="BOTTOMLEFT" y="-2"/></Anchors>
                        <KeyValues>
                            <KeyValue key="tooltipText" value="Class Quests" type="string"/>
                            <KeyValue key="iconTexture" value="Interface\Icons\INV_Misc_Book_07" type="string"/>
                        </KeyValues>
                    </Frame>
                    <Frame parentKey="ActiveChains" inherits="ForeverQuestChainJournalTabTemplate">
                        <Anchors><Anchor point="TOPLEFT" relativeKey="$parent.Classes" relativePoint="BOTTOMLEFT" y="-2"/></Anchors>
                        <KeyValues>
                            <KeyValue key="tooltipText" value="Active Chains" type="string"/>
                            <KeyValue key="iconTexture" value="Interface\Icons\INV_Misc_Note_05" type="string"/>
                        </KeyValues>
                    </Frame>
                </Frames>
            </Frame>
            <Frame parentKey="LocationNav">
                <Size y="26"/>
                <Anchors>
                    <Anchor point="TOPLEFT" x="26" y="-64"/>
                    <Anchor point="TOPRIGHT" x="-26" y="-64"/>
                </Anchors>
                <Layers>
                    <Layer level="OVERLAY">
                        <FontString parentKey="Heading" inherits="GameFontNormalLarge" justifyH="LEFT" justifyV="TOP" wordwrap="false">
                            <Anchors><Anchor point="RIGHT" x="-236"/></Anchors>
                            <Color r="1" g="0.82" b="0"/>
                        </FontString>
                    </Layer>
                </Layers>
                <Frames>
                    <Button parentKey="Home" inherits="ForeverQuestChainBreadcrumbTemplate">
                        <Anchors><Anchor point="LEFT"/></Anchors>
                    </Button>
                    <Button parentKey="Quests" inherits="ForeverQuestChainControlTemplate" text="Quests">
                        <Size x="104" y="24"/>
                        <Anchors><Anchor point="RIGHT" x="-112"/></Anchors>
                    </Button>
                    <Button parentKey="Rewards" inherits="ForeverQuestChainControlTemplate" text="Rewards">
                        <Size x="104" y="24"/>
                        <Anchors><Anchor point="RIGHT"/></Anchors>
                    </Button>
                </Frames>
            </Frame>
        </Frames>
    </Frame>
</Ui>
