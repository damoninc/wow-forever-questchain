            </EditBox>
            <Frame parentKey="RewardItems" inherits="ForeverQuestChainListPanelTemplate">
                <Anchors><Anchor point="TOPLEFT" y="-85"/></Anchors>
            </Frame>
            <Frame parentKey="RewardSources" inherits="ForeverQuestChainListPanelTemplate">
