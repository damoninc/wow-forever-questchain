<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <Frame name="ForeverQuestChainRewardPageTemplate"
           mixin="ForeverQuestChainRewardPageMixin" virtual="true">
        <Layers>
            <Layer level="OVERLAY">
                <FontString parentKey="SearchHint" inherits="GameFontDisableSmall" justifyH="LEFT" justifyV="TOP"
                            text="Find a quest reward by item name or ID">
                    <Size x="380"/>
                    <Anchors><Anchor point="TOPLEFT" x="23" y="-54"/></Anchors>
                    <Color r="0.76" g="0.73" b="0.66"/>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <EditBox parentKey="SearchBox" inherits="InputBoxTemplate" autoFocus="false" letters="100">
                <Size x="400" y="24"/>
                <Anchors><Anchor point="TOPLEFT" x="19" y="-48"/></Anchors>
            </EditBox>
            <Frame parentKey="RewardItems" inherits="ForeverQuestChainListPanelTemplate">
                <Anchors><Anchor point="TOPLEFT" y="-85"/></Anchors>
            </Frame>
            <Frame parentKey="RewardSources" inherits="ForeverQuestChainListPanelTemplate">
                <Anchors><Anchor point="TOPRIGHT" y="-85"/></Anchors>
            </Frame>
        </Frames>
    </Frame>
</Ui>
