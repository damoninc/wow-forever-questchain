<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <Frame name="ForeverQuestChainQuestListTemplate" virtual="true">
        <Layers>
            <Layer level="OVERLAY">
                <FontString parentKey="Heading" inherits="GameFontNormalLarge" justifyH="LEFT" justifyV="TOP" text="Find a quest">
                    <Size x="260"/>
                    <Anchors><Anchor point="TOPLEFT" x="12" y="-9"/></Anchors>
                    <Color r="1" g="0.82" b="0"/>
                </FontString>
                <FontString parentKey="SearchHint" inherits="GameFontDisableSmall" justifyH="LEFT" justifyV="TOP" text="Quest name or ID">
                    <Size x="420"/>
                    <Anchors><Anchor point="TOPLEFT" x="23" y="-54"/></Anchors>
                    <Color r="0.76" g="0.73" b="0.66"/>
                </FontString>
                <FontString parentKey="CategoryHint" inherits="GameFontHighlightSmall" justifyH="LEFT" justifyV="TOP"
                            text="Quest chains and standalone quests" hidden="true">
                    <Size x="470"/>
                    <Anchors><Anchor point="TOPLEFT" x="12" y="-54"/></Anchors>
                    <Color r="0.76" g="0.73" b="0.66"/>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <EditBox parentKey="SearchBox" inherits="InputBoxTemplate" autoFocus="false" letters="100">
                <Size x="443" y="24"/>
                <Anchors><Anchor point="TOPLEFT" x="19" y="-48"/></Anchors>
            </EditBox>
            <Button parentKey="Go" inherits="ForeverQuestChainControlTemplate" text="Go">
                <Size x="74" y="24"/>
                <Anchors><Anchor point="LEFT" relativeKey="$parent.SearchBox" relativePoint="RIGHT" x="10"/></Anchors>
            </Button>
            <Button parentKey="ClassQuests" inherits="ForeverQuestChainControlTemplate" text="Class quests">
                <Size x="118" y="24"/>
                <Anchors><Anchor point="TOPRIGHT" x="-12" y="-8"/></Anchors>
            </Button>
            <CheckButton parentKey="HideCompleted" inherits="UICheckButtonTemplate" hidden="true">
                <Size x="22" y="22"/>
                <Anchors><Anchor point="TOPLEFT" x="524" y="-48"/></Anchors>
            </CheckButton>
            <Button parentKey="ShowCompleted" inherits="ForeverQuestChainControlTemplate" text="Show completed" hidden="true">
                <Size x="130" y="24"/>
                <Anchors><Anchor point="TOPLEFT" x="680" y="-48"/></Anchors>
            </Button>
        </Frames>
    </Frame>

    <Frame name="ForeverQuestChainRewardCatalogTemplate" virtual="true">
        <Layers>
            <Layer level="OVERLAY">
                <FontString parentKey="SearchHint" inherits="GameFontDisableSmall" justifyH="LEFT" justifyV="TOP"
                            text="Find a quest reward by item name or ID">
                    <Size x="380"/>
                    <Anchors><Anchor point="TOPLEFT" x="23" y="-54"/></Anchors>
                    <Color r="0.76" g="0.73" b="0.66"/>
                </FontString>
            </Layer>
        </Layers>
        <Frames>
            <EditBox parentKey="SearchBox" inherits="InputBoxTemplate" autoFocus="false" letters="100">
                <Size x="400" y="24"/>
                <Anchors><Anchor point="TOPLEFT" x="19" y="-48"/></Anchors>
            </EditBox>
        </Frames>
    </Frame>

    <Frame name="ForeverQuestChainQuestDetailsTemplate" virtual="true">
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Parchment" atlas="QuestDetailsBackgrounds" useAtlasSize="true">
                    <Anchors>
                        <Anchor point="TOPLEFT"/>
                        <Anchor point="BOTTOMRIGHT" x="-20"/>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="BORDER">
                <Texture atlas="questlog-reward-top-frame">
                    <Size y="43"/>
                    <Anchors>
                        <Anchor point="TOPLEFT"/>
                        <Anchor point="TOPRIGHT" x="-20"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        <Frames>
            <Frame inherits="QuestLogBorderFrameTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" x="-3" y="7"/>
                    <Anchor point="BOTTOMRIGHT" x="-17" y="-6"/>
                </Anchors>
            </Frame>
            <Button parentKey="BackButton" inherits="ForeverQuestChainControlTemplate" text="BACK">
                <Size x="90" y="24"/>
                <Anchors><Anchor point="TOPLEFT" x="11" y="-10"/></Anchors>
            </Button>
            <ScrollFrame parentKey="DetailsScroll" inherits="ScrollFrameTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT" x="3" y="-50"/>
                    <Anchor point="BOTTOMRIGHT" x="-23" y="7"/>
                </Anchors>
                <ScrollChild>
                    <Frame parentKey="Content">
                        <Size x="1" y="1"/>
                    </Frame>
                </ScrollChild>
            </ScrollFrame>
        </Frames>
    </Frame>
</Ui>
